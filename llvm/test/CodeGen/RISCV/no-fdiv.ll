; CORE-ET ET-Minion has no hardware floating point division or square-root hardware; 
; fdiv.s and fsqrt.s traditionally traps to M-mode for emulation. +no-fdiv calls the
; soft-float routines instead, the same as GCC's -mno-fdiv.

define float @fdiv(float %a, float %b) {
; NOFDIV-LABEL: fdiv:
; NOFDIV:       # %bb.0:
; NOFDIV-NEXT:    tail __divsf3
;
; FDIV-LABEL: fdiv:
; FDIV:       # %bb.0:
; FDIV-NEXT:    fdiv.s fa0, fa0, fa1
; FDIV-NEXT:    ret
;
; ETSOC1-LABEL: fdiv:
; ETSOC1:       # %bb.0:
; ETSOC1-NEXT:    tail __divsf3
;
; ERBIUM-LABEL: fdiv:
; ERBIUM:       # %bb.0:
; ERBIUM-NEXT:    tail __divsf3
  %r = fdiv float %a, %b
  ret float %r
}

declare float @llvm.sqrt.f32(float)
define float @fsqrt(float %a) {
; NOFDIV-LABEL: fsqrt:
; NOFDIV:       # %bb.0:
; NOFDIV-NEXT:    tail sqrtf
;
; FDIV-LABEL: fsqrt:
; FDIV:       # %bb.0:
; FDIV-NEXT:    fsqrt.s fa0, fa0
; FDIV-NEXT:    ret
;
; ETSOC1-LABEL: fsqrt:
; ETSOC1:       # %bb.0:
; ETSOC1-NEXT:    tail sqrtf
;
; ERBIUM-LABEL: fsqrt:
; ERBIUM:       # %bb.0:
; ERBIUM-NEXT:    tail sqrtf
  %r = call float @llvm.sqrt.f32(float %a)
  ret float %r
}

; Multiply, add and conversions are unaffected.
define float @fmul(float %a, float %b) {
; NOFDIV-LABEL: fmul:
